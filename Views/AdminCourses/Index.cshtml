@model List<CampusLearn.Models.Course>
@{
    ViewData["Title"] = "Course Management";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="Admin" asp-action="Dashboard" class="badge bg-warning text-dark text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Admin Console
                </a>
            </div>
            <h1 class="fw-bold text-dark mb-0">Course Management</h1>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="AdminCourses" asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Course
            </a>
        </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="card border-0 shadow-sm rounded-4 p-3 mb-4 bg-white">
        <form asp-controller="AdminCourses" asp-action="Index" method="get">
            <div class="row g-2 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control bg-light border-start-0" placeholder="Search by course title or keyword..." />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="category" class="form-select bg-light" onchange="this.form.submit()">
                        <option value="">All Categories</option>
                        @if (ViewBag.Categories is List<string> categories)
                        {
                            foreach (var cat in categories)
                            {
                                <option value="@cat" selected="@(cat == (string?)ViewBag.SelectedCategory)">@cat</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-semibold btn-sm">Filter</button>
                    @if (!string.IsNullOrEmpty((string?)ViewBag.SearchTerm) || !string.IsNullOrEmpty((string?)ViewBag.SelectedCategory))
                    {
                        <a asp-controller="AdminCourses" asp-action="Index" class="btn btn-outline-secondary rounded-pill btn-sm px-3" title="Clear Filters">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th style="width: 80px;">Image</th>
                        <th>Course Title</th>
                        <th>Category</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th>Lessons</th>
                        <th>Enrollments</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=100&auto=format&fit=crop&q=80" : item.ImageUrl)" 
                                         class="rounded-3" width="50" height="35" style="object-fit: cover;" alt="Course" />
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@item.Title</div>
                                    <div class="text-muted small line-clamp-1">@item.Description</div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary">@(item.Category ?? "General")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@(item.Duration ?? "Self-paced")</span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="AdminLessons" asp-action="Index" asp-route-courseId="@item.CourseId" class="badge bg-secondary text-decoration-none">
                                        @(item.Lessons?.Count ?? 0) lessons
                                    </a>
                                </td>
                                <td>
                                    <span class="text-muted small fw-semibold">@(item.Enrollments?.Count ?? 0) learners</span>
                                </td>
                                <td>
                                    <span class="text-muted small">@item.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="AdminCourses" asp-action="Details" asp-route-id="@item.CourseId" class="btn btn-light border" title="View Details">
                                            <i class="bi bi-eye text-primary"></i>
                                        </a>
                                        <a asp-controller="AdminCourses" asp-action="Edit" asp-route-id="@item.CourseId" class="btn btn-light border" title="Edit Course">
                                            <i class="bi bi-pencil text-warning"></i>
                                        </a>
                                        <a asp-controller="AdminCourses" asp-action="Delete" asp-route-id="@item.CourseId" class="btn btn-light border" title="Delete Course">
                                            <i class="bi bi-trash text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-4 text-muted">
                                No courses created yet. Click "Add New Course" above.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
