@model CampusLearn.Models.Course
@{
    ViewData["Title"] = $"Course Details: {Model.Title}";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-controller="AdminCourses" asp-action="Index">Courses</a></li>
                    <li class="breadcrumb-item active">@Model.Title</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">@Model.Title</h2>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="AdminLessons" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-primary rounded-pill px-3 btn-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Lesson
            </a>
            <a asp-controller="AdminQuizzes" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-warning text-dark rounded-pill px-3 btn-sm fw-semibold">
                <i class="bi bi-patch-question me-1"></i> Add Quiz
            </a>
            <a asp-controller="AdminCourses" asp-action="Edit" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                <i class="bi bi-pencil me-1"></i> Edit Course
            </a>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-3">Course Summary</h5>
                <p class="text-muted">@Model.Description</p>
                <div class="d-flex gap-2 mt-3 flex-wrap">
                    @if (!string.IsNullOrEmpty(Model.Category))
                    {
                        <span class="badge bg-primary">Category: @Model.Category</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Duration))
                    {
                        <span class="badge bg-dark">Duration: @Model.Duration</span>
                    }
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">@(Model.IsActive ? "Active" : "Inactive")</span>
                    <span class="badge bg-light text-dark border">Created: @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                </div>
            </div>

            <!-- Lessons in this Course -->
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
                <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-journal-text text-primary me-2"></i> Lessons (@(Model.Lessons?.Count ?? 0))
                    </h6>
                    <a asp-controller="AdminLessons" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-sm btn-outline-primary rounded-pill">
                        + Add Lesson
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>#</th>
                                <th>Title</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Lessons != null && Model.Lessons.Any())
                            {
                                foreach (var l in Model.Lessons.OrderBy(x => x.LessonOrder))
                                {
                                    <tr>
                                        <td>Lesson @l.LessonOrder</td>
                                        <td class="fw-semibold">@l.Title</td>
                                        <td class="text-end">
                                            <a asp-controller="AdminLessons" asp-action="Edit" asp-route-id="@l.LessonId" class="btn btn-sm btn-light border">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-controller="AdminLessons" asp-action="Delete" asp-route-id="@l.LessonId" class="btn btn-sm btn-light border text-danger">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-3 text-muted small">No lessons yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Quizzes in this Course -->
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                <div class="card-header bg-white p-3 border-bottom d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-patch-question text-warning me-2"></i> Quizzes (@(Model.Quizzes?.Count ?? 0))
                    </h6>
                    <a asp-controller="AdminQuizzes" asp-action="Create" asp-route-courseId="@Model.CourseId" class="btn btn-sm btn-outline-warning text-dark fw-semibold rounded-pill">
                        + Add Quiz
                    </a>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small">
                            <tr>
                                <th>Quiz Title</th>
                                <th>Questions</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Quizzes != null && Model.Quizzes.Any())
                            {
                                foreach (var q in Model.Quizzes)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <a asp-controller="AdminQuizzes" asp-action="Details" asp-route-id="@q.QuizId" class="text-dark text-decoration-none">
                                                @q.Title
                                            </a>
                                        </td>
                                        <td><span class="badge bg-info-subtle text-info">@(q.Questions?.Count ?? 0) questions</span></td>
                                        <td class="text-end">
                                            <a asp-controller="AdminQuizzes" asp-action="Details" asp-route-id="@q.QuizId" class="btn btn-sm btn-light border" title="Manage Questions">
                                                <i class="bi bi-list-check text-primary"></i>
                                            </a>
                                            <a asp-controller="AdminQuizzes" asp-action="Edit" asp-route-id="@q.QuizId" class="btn btn-sm btn-light border" title="Edit Quiz">
                                                <i class="bi bi-pencil text-warning"></i>
                                            </a>
                                            <a asp-controller="AdminQuizzes" asp-action="Delete" asp-route-id="@q.QuizId" class="btn btn-sm btn-light border text-danger" title="Delete Quiz">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center py-3 text-muted small">No quizzes yet.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Enrolled Learners -->
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-people text-primary me-2"></i> Enrolled Learners (@(Model.Enrollments?.Count ?? 0))
                </h5>
                @if (Model.Enrollments != null && Model.Enrollments.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var en in Model.Enrollments)
                        {
                            <div class="p-2 bg-light rounded-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold small text-dark">@(en.User?.FullName ?? en.User?.Email ?? "User")</div>
                                    <div class="text-muted small">@en.EnrollmentDate.ToString("MMM dd, yyyy")</div>
                                </div>
                                @if (en.Status == "Completed")
                                {
                                    <span class="badge bg-success">Done</span>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No learners enrolled yet.</p>
                }
            </div>
        </div>
    </div>
</div>
