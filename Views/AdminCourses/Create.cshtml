@model CampusLearn.ViewModels.CourseFormViewModel
@{
    ViewData["Title"] = "Create New Course";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Create Course</h3>
                    <p class="text-muted small mb-0">Define the metadata and details for a new course</p>
                </div>
                <a asp-controller="AdminCourses" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Courses
                </a>
            </div>

            <form asp-controller="AdminCourses" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Course Title</label>
                    <input asp-for="Title" class="form-control bg-light" placeholder="e.g. Modern Full-Stack Development with ASP.NET Core" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold">Course Overview / Description</label>
                    <textarea asp-for="Description" class="form-control bg-light" rows="4" placeholder="Comprehensive summary of what students will learn in this course..." required></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Category" class="form-label fw-semibold">Category</label>
                        <input asp-for="Category" class="form-control bg-light" placeholder="e.g. Web Development, AI, Data Structures" required />
                        <span asp-validation-for="Category" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Duration" class="form-label fw-semibold">Duration</label>
                        <input asp-for="Duration" class="form-control bg-light" placeholder="e.g. 6 Weeks or 20 Hours" required />
                        <span asp-validation-for="Duration" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="ImageUrl" class="form-label fw-semibold">Banner Image URL (Optional)</label>
                    <input asp-for="ImageUrl" class="form-control bg-light" placeholder="https://images.unsplash.com/... or /images/course.jpg" />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="mb-4 form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label fw-semibold">Is Course Active & Available for Enrollment?</label>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="AdminCourses" asp-action="Index" class="btn btn-light border rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-semibold shadow-sm">
                        <i class="bi bi-check2 me-1"></i> Save Course
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
