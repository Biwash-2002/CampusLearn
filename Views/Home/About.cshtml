@{
    ViewData["Title"] = "About CampusLearn";
}

<div class="py-4">
    <!-- Header Banner -->
    <div class="bg-primary bg-gradient text-white rounded-4 p-5 mb-5 shadow-sm text-center">
        <span class="badge bg-white bg-opacity-25 text-white px-3 py-2 rounded-pill mb-3">
            Academic Project Presentation
        </span>
        <h1 class="display-5 fw-bold mb-3">About CampusLearn</h1>
        <p class="lead max-w-700 mx-auto opacity-90 mb-0">
            A Web-Based Course Delivery and Progress Tracking Portal built for university and college learning environments.
        </p>
    </div>

    <!-- Project Overview -->
    <div class="row g-5 align-items-center mb-5">
        <div class="col-lg-6">
            <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Project Mission</span>
            <h2 class="fw-bold mb-3">Bridging Classrooms and Digital Learning</h2>
            <p class="text-muted mb-4">
                CampusLearn was conceived to provide educational institutions with an accessible, high-performance web platform that simplifies curriculum dissemination, provides engaging lesson content, automated evaluations through quizzes, and transparent tracking of student progress.
            </p>
            <div class="d-flex flex-column gap-3">
                <div class="d-flex align-items-start">
                    <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary me-3 flex-shrink-0" style="width: 42px; height: 42px;">
                        <i class="bi bi-person-check fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Dual-Role Architecture</h6>
                        <p class="text-muted small mb-0">Distinct, secure portals for Learners and Administrators with role-based authorization.</p>
                    </div>
                </div>
                <div class="d-flex align-items-start">
                    <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success me-3 flex-shrink-0" style="width: 42px; height: 42px;">
                        <i class="bi bi-clipboard2-data fs-5"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1">Automated Grading & Feedback</h6>
                        <p class="text-muted small mb-0">Instant scoring of multiple choice questions with feedback and lesson completion triggers.</p>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                    <i class="bi bi-stack text-primary me-2"></i> Technology Stack
                </h5>
                <div class="table-responsive">
                    <table class="table table-borderless align-middle mb-0">
                        <tbody>
                            <tr>
                                <td class="fw-semibold text-muted small" style="width: 35%;">Framework</td>
                                <td><span class="badge bg-primary-subtle text-primary fw-semibold">ASP.NET Core 10 MVC (C#)</span></td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted small">Data Layer</td>
                                <td><span class="badge bg-info-subtle text-info fw-semibold">Entity Framework Core 10</span></td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted small">Database</td>
                                <td><span class="badge bg-secondary-subtle text-secondary fw-semibold">Microsoft SQL Server / SQLite</span></td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted small">Authentication</td>
                                <td><span class="badge bg-success-subtle text-success fw-semibold">ASP.NET Core Identity (RBAC)</span></td>
                            </tr>
                            <tr>
                                <td class="fw-semibold text-muted small">Frontend</td>
                                <td><span class="badge bg-warning-subtle text-warning fw-semibold">Razor Views, Bootstrap 5.3, HTML5, CSS3, JS</span></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
