@{
    ViewData["Title"] = "Modern Course Delivery & Progress Portal";
    var featuredCourses = ViewBag.FeaturedCourses as List<CampusLearn.Models.Course> ?? new List<CampusLearn.Models.Course>();
}

<!-- Hero Section -->
<section class="hero-section p-5 mb-5 shadow-lg">
    <div class="row align-items-center py-4">
        <div class="col-lg-7">
            <span class="badge bg-primary bg-opacity-25 text-primary-light border border-primary border-opacity-50 px-3 py-2 rounded-pill mb-3">
                <i class="bi bi-stars me-1"></i> Next-Generation College Learning
            </span>
            <h1 class="display-4 fw-extrabold text-white mb-3">
                Master Skills with <br><span class="text-gradient">CampusLearn</span> Portal
            </h1>
            <p class="lead text-light opacity-75 mb-4 pe-lg-4">
                Structured courses, interactive coding and theory lessons, dynamic quizzes, and real-time progress analytics — all built for academic excellence.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Courses" asp-action="Index" class="btn btn-primary btn-lg rounded-pill px-4 shadow">
                    <i class="bi bi-compass me-2"></i> Explore Courses
                </a>
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-lg rounded-pill px-4">
                        <i class="bi bi-person-plus me-2"></i> Join as Learner
                    </a>
                }
                else
                {
                    <a asp-controller="Learner" asp-action="Dashboard" class="btn btn-outline-light btn-lg rounded-pill px-4">
                        <i class="bi bi-speedometer2 me-2"></i> Go to Dashboard
                    </a>
                }
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center position-relative">
            <div class="p-4 bg-white bg-opacity-10 rounded-4 border border-white border-opacity-25 backdrop-blur shadow-2xl">
                <div class="d-flex align-items-center justify-content-between text-white border-bottom border-white border-opacity-10 pb-3 mb-3">
                    <div class="d-flex align-items-center">
                        <div class="brand-icon me-2 rounded-2 d-flex align-items-center justify-content-center text-white">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <span class="fw-bold">Learning Metrics</span>
                    </div>
                    <span class="badge bg-success rounded-pill px-3 py-1">Active</span>
                </div>
                <div class="row g-3 text-start">
                    <div class="col-6">
                        <div class="p-3 bg-dark bg-opacity-50 rounded-3">
                            <div class="text-muted small">Total Courses</div>
                            <div class="fs-4 fw-bold text-white">@ViewBag.TotalCourses</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-dark bg-opacity-50 rounded-3">
                            <div class="text-muted small">Enrolled Students</div>
                            <div class="fs-4 fw-bold text-white">@ViewBag.TotalLearners</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-dark bg-opacity-50 rounded-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted small">Course Completion Average</span>
                                <span class="text-white small fw-bold">84%</span>
                            </div>
                            <div class="progress" style="height: 6px;">
                                <div class="progress-bar bg-success" style="width: 84%"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Metrics Row -->
<section class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary me-3">
                <i class="bi bi-collection-play-fill"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">@ViewBag.TotalCourses</h3>
                <p class="text-muted mb-0 small">Curated Academic Courses</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success me-3">
                <i class="bi bi-people-fill"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">@ViewBag.TotalLearners</h3>
                <p class="text-muted mb-0 small">Active Campus Learners</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card d-flex align-items-center">
            <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning me-3">
                <i class="bi bi-check2-circle"></i>
            </div>
            <div>
                <h3 class="fw-bold mb-0">@ViewBag.TotalEnrollments</h3>
                <p class="text-muted mb-0 small">Completed Enrollments</p>
            </div>
        </div>
    </div>
</section>

<!-- Featured Courses Section -->
<section class="mb-5">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Featured Courses</h2>
            <p class="text-muted mb-0">Explore our most popular and comprehensive courses</p>
        </div>
        <a asp-controller="Courses" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 mt-3 mt-md-0 fw-semibold">
            View All Courses <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>

    <div class="row">
        @if (featuredCourses.Any())
        {
            foreach (var course in featuredCourses)
            {
                <partial name="_CourseCard" model="course" />
            }
        }
        else
        {
            <div class="col-12 text-center py-5 bg-white rounded-4 border">
                <i class="bi bi-journal-x fs-1 text-muted"></i>
                <p class="mt-3 text-muted">No courses available at the moment.</p>
            </div>
        }
    </div>
</section>

<!-- Key Platform Pillars -->
<section class="py-5 my-4 bg-white rounded-4 border p-4 p-md-5">
    <div class="text-center max-w-700 mx-auto mb-5">
        <span class="badge bg-primary-subtle text-primary fw-semibold px-3 py-2 rounded-pill mb-2">Why CampusLearn</span>
        <h2 class="fw-bold">Engineered for Academic Mastery</h2>
        <p class="text-muted">Everything you need to deliver, learn, and evaluate coursework in one seamless environment.</p>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="p-4 rounded-3 bg-light h-100 border">
                <div class="stat-icon-wrapper bg-primary text-white mb-3 shadow-sm">
                    <i class="bi bi-book"></i>
                </div>
                <h5 class="fw-bold">Modular Lessons</h5>
                <p class="text-muted small mb-0">
                    Structured bite-sized lessons with code syntax highlighting, rich explanations, and step-by-step guidance.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded-3 bg-light h-100 border">
                <div class="stat-icon-wrapper bg-success text-white mb-3 shadow-sm">
                    <i class="bi bi-patch-question"></i>
                </div>
                <h5 class="fw-bold">Automated Quizzes</h5>
                <p class="text-muted small mb-0">
                    Instant grading and feedback on multiple choice quizzes to test and solidify learner comprehension.
                </p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-4 rounded-3 bg-light h-100 border">
                <div class="stat-icon-wrapper bg-secondary text-white mb-3 shadow-sm">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <h5 class="fw-bold">Real-Time Progress Tracking</h5>
                <p class="text-muted small mb-0">
                    Automated percentage tracking, lesson completion checkmarks, and overall course accomplishment analytics.
                </p>
            </div>
        </div>
    </div>
</section>
