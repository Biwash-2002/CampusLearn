@model CampusLearn.ViewModels.QuizTakingViewModel
@{
    ViewData["Title"] = $"Quiz: {Model.QuizTitle}";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-8">
        <!-- Quiz Header -->
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
            <div class="d-flex align-items-center gap-2 mb-2">
                <a asp-controller="Learner" asp-action="MyCourses" class="badge bg-secondary text-white text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> My Courses
                </a>
                <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill">@Model.CourseTitle</span>
            </div>
            <h2 class="fw-bold text-dark mb-2">@Model.QuizTitle</h2>
            <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.QuizDescription) ? "Select the single best answer for each multiple-choice question below and submit when ready." : Model.QuizDescription)</p>
            
            <div class="d-flex align-items-center gap-4 mt-3 pt-3 border-top text-muted small">
                <span><i class="bi bi-patch-question text-primary me-1"></i> Total Questions: <strong>@Model.Questions.Count</strong></span>
                <span><i class="bi bi-trophy text-primary me-1"></i> Passing Benchmark: <strong>60%</strong></span>
            </div>
        </div>

        @if (Model.Questions.Any())
        {
            <!-- Quiz Form -->
            <form asp-controller="Quizzes" asp-action="Submit" method="post" id="quizForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="quizId" value="@Model.QuizId" />

                <div class="d-flex flex-column gap-4 mb-4">
                    @for (int i = 0; i < Model.Questions.Count; i++)
                    {
                        var q = Model.Questions[i];
                        var qNum = i + 1;
                        var radioName = $"question_{q.QuestionId}";

                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                            <div class="d-flex align-items-start gap-3 mb-3">
                                <span class="badge bg-primary rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px; font-size: 0.9rem;">
                                    @qNum
                                </span>
                                <h5 class="fw-bold text-dark mb-0 pt-1">@q.QuestionText</h5>
                            </div>

                            <div class="d-flex flex-column gap-2 ms-md-4">
                                <!-- Option A -->
                                <div class="form-check p-2 rounded-3 border bg-light ps-4">
                                    <input class="form-check-input ms-0 me-2" type="radio" name="@radioName" id="q@(q.QuestionId)_A" value="A" required />
                                    <label class="form-check-label w-100 text-dark fw-medium" for="q@(q.QuestionId)_A">
                                        <span class="badge bg-secondary me-2">A</span> @q.OptionA
                                    </label>
                                </div>

                                <!-- Option B -->
                                <div class="form-check p-2 rounded-3 border bg-light ps-4">
                                    <input class="form-check-input ms-0 me-2" type="radio" name="@radioName" id="q@(q.QuestionId)_B" value="B" required />
                                    <label class="form-check-label w-100 text-dark fw-medium" for="q@(q.QuestionId)_B">
                                        <span class="badge bg-secondary me-2">B</span> @q.OptionB
                                    </label>
                                </div>

                                <!-- Option C -->
                                <div class="form-check p-2 rounded-3 border bg-light ps-4">
                                    <input class="form-check-input ms-0 me-2" type="radio" name="@radioName" id="q@(q.QuestionId)_C" value="C" required />
                                    <label class="form-check-label w-100 text-dark fw-medium" for="q@(q.QuestionId)_C">
                                        <span class="badge bg-secondary me-2">C</span> @q.OptionC
                                    </label>
                                </div>

                                <!-- Option D -->
                                <div class="form-check p-2 rounded-3 border bg-light ps-4">
                                    <input class="form-check-input ms-0 me-2" type="radio" name="@radioName" id="q@(q.QuestionId)_D" value="D" required />
                                    <label class="form-check-label w-100 text-dark fw-medium" for="q@(q.QuestionId)_D">
                                        <span class="badge bg-secondary me-2">D</span> @q.OptionD
                                    </label>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Action Bar -->
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Return to Course
                    </a>
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow">
                        Submit Quiz Answers <i class="bi bi-send-check ms-1"></i>
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                <i class="bi bi-info-circle display-4 text-muted d-block mb-3 opacity-50"></i>
                <h4 class="fw-bold text-dark mb-2">No Questions Available</h4>
                <p class="text-muted mb-4">This quiz does not currently have any questions assigned. Please check back later.</p>
                <div>
                    <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-primary rounded-pill px-4">
                        Return to Course
                    </a>
                </div>
            </div>
        }
    </div>
</div>
