@model CampusLearn.Models.Lesson
@{
    ViewData["Title"] = $"Lesson Details: {Model.Title}";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Admin" asp-action="Dashboard">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-controller="AdminLessons" asp-action="Index" asp-route-courseId="@Model.CourseId">Lessons</a></li>
                    <li class="breadcrumb-item active">Lesson #@Model.LessonOrder</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">Lesson #@Model.LessonOrder: @Model.Title</h2>
            <div class="text-muted small mt-1">
                Belongs to Course: <a asp-controller="AdminCourses" asp-action="Details" asp-route-id="@Model.CourseId" class="text-primary fw-semibold text-decoration-none">@Model.Course.Title</a>
            </div>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="AdminLessons" asp-action="Edit" asp-route-id="@Model.LessonId" class="btn btn-warning text-dark rounded-pill px-3 btn-sm fw-semibold">
                <i class="bi bi-pencil me-1"></i> Edit Lesson
            </a>
            <a asp-controller="AdminLessons" asp-action="Delete" asp-route-id="@Model.LessonId" class="btn btn-outline-danger rounded-pill px-3 btn-sm">
                <i class="bi bi-trash me-1"></i> Delete
            </a>
            <a asp-controller="AdminLessons" asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Lessons
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Lesson Content Preview (Left) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5 mb-4">
                <h5 class="fw-bold text-dark mb-3 border-bottom pb-2">
                    <i class="bi bi-file-earmark-richtext text-primary me-2"></i> Lesson Content
                </h5>
                <div class="lesson-rendered-content text-dark" style="line-height: 1.8;">
                    @Html.Raw(Model.Content)
                </div>
            </div>
        </div>

        <!-- Lesson Metadata & Progress Analytics (Right) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
                <h5 class="fw-bold text-dark mb-3">Lesson Metadata</h5>
                <ul class="list-unstyled text-muted small d-flex flex-column gap-2 mb-0">
                    <li class="d-flex justify-content-between">
                        <span><i class="bi bi-hash text-primary me-2"></i> Lesson Order:</span>
                        <span class="fw-bold text-dark">#@Model.LessonOrder</span>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span><i class="bi bi-journal text-primary me-2"></i> Course:</span>
                        <span class="fw-bold text-dark text-truncate" style="max-width: 180px;">@Model.Course.Title</span>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span><i class="bi bi-calendar text-primary me-2"></i> Created:</span>
                        <span class="fw-bold text-dark">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                    </li>
                    <li class="d-flex justify-content-between">
                        <span><i class="bi bi-check2-circle text-success me-2"></i> Completions:</span>
                        <span class="badge bg-success">@(Model.LessonProgresses?.Count(lp => lp.Completed) ?? 0) learners</span>
                    </li>
                </ul>
            </div>

            <!-- Recent Completions -->
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-people text-primary me-2"></i> Completed Learners
                </h5>
                @if (Model.LessonProgresses != null && Model.LessonProgresses.Any(lp => lp.Completed))
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var prog in Model.LessonProgresses.Where(lp => lp.Completed))
                        {
                            <div class="p-2 bg-light rounded-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold small text-dark">@(prog.User?.FullName ?? prog.User?.Email ?? "Learner")</div>
                                    <div class="text-muted small">@prog.CompletedAt?.ToString("MMM dd, yyyy")</div>
                                </div>
                                <span class="badge bg-success"><i class="bi bi-check-lg"></i></span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No learners have marked this lesson as completed yet.</p>
                }
            </div>
        </div>
    </div>
</div>
