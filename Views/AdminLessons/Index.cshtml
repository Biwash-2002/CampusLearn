@model List<CampusLearn.Models.Lesson>
@{
    ViewData["Title"] = "Lesson Management";
    var courses = ViewBag.Courses as List<CampusLearn.Models.Course> ?? new List<CampusLearn.Models.Course>();
    int? selectedCourseId = ViewBag.CourseId as int?;
    var selectedCourse = ViewBag.SelectedCourse as CampusLearn.Models.Course;
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="Admin" asp-action="Dashboard" class="badge bg-warning text-dark text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Admin Console
                </a>
            </div>
            <h1 class="fw-bold text-dark mb-0">
                Lesson Management @(selectedCourse != null ? $"- {selectedCourse.Title}" : "")
            </h1>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="AdminLessons" asp-action="Create" asp-route-courseId="@selectedCourseId" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add New Lesson
            </a>
        </div>
    </div>

    <!-- Filter by Course -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-4">
        <form asp-controller="AdminLessons" asp-action="Index" method="get" class="d-flex align-items-center gap-3">
            <label class="fw-semibold text-muted small flex-shrink-0">Filter by Course:</label>
            <select name="courseId" class="form-select bg-light" onchange="this.form.submit()">
                <option value="">All Courses (@courses.Count)</option>
                @foreach (var c in courses)
                {
                    <option value="@c.CourseId" selected="@(c.CourseId == selectedCourseId)">@c.Title</option>
                }
            </select>
        </form>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th style="width: 80px;">Order</th>
                        <th>Course</th>
                        <th>Lesson Title</th>
                        <th>Progress Count</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td><span class="badge bg-light text-dark border">#@item.LessonOrder</span></td>
                                <td class="fw-semibold text-primary">@item.Course.Title</td>
                                <td class="fw-bold text-dark">@item.Title</td>
                                <td>
                                    <span class="text-muted small">@(item.LessonProgresses?.Count(lp => lp.Completed) ?? 0) completions</span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="AdminLessons" asp-action="Details" asp-route-id="@item.LessonId" class="btn btn-light border" title="View Lesson Details">
                                            <i class="bi bi-eye text-primary"></i>
                                        </a>
                                        <a asp-controller="AdminLessons" asp-action="Edit" asp-route-id="@item.LessonId" class="btn btn-light border" title="Edit Lesson">
                                            <i class="bi bi-pencil text-warning"></i>
                                        </a>
                                        <a asp-controller="AdminLessons" asp-action="Delete" asp-route-id="@item.LessonId" class="btn btn-light border" title="Delete Lesson">
                                            <i class="bi bi-trash text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No lessons found. Click "Add New Lesson" above to add one.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
