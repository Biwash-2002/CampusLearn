@model CampusLearn.ViewModels.LessonFormViewModel
@{
    ViewData["Title"] = $"Edit Lesson: {Model.Title}";
}

<div class="row justify-content-center py-4">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                <div>
                    <h3 class="fw-bold text-dark mb-1">Edit Lesson</h3>
                    <p class="text-muted small mb-0">Update educational material and ordering</p>
                </div>
                <a asp-controller="AdminLessons" asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                    <i class="bi bi-arrow-left me-1"></i> Back to Lessons
                </a>
            </div>

            <form asp-controller="AdminLessons" asp-action="Edit" asp-route-id="@Model.LessonId" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="LessonId" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="CourseId" class="form-label fw-semibold">Target Course</label>
                        <select asp-for="CourseId" asp-items="ViewBag.CoursesList" class="form-select bg-light" required></select>
                        <span asp-validation-for="CourseId" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="LessonOrder" class="form-label fw-semibold">Lesson Order</label>
                        <input asp-for="LessonOrder" type="number" class="form-control bg-light" min="1" required />
                        <span asp-validation-for="LessonOrder" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Lesson Title</label>
                    <input asp-for="Title" class="form-control bg-light" required />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Content" class="form-label fw-semibold">Lesson Content (HTML formatting supported)</label>
                    <textarea asp-for="Content" class="form-control bg-light font-monospace" rows="12" required></textarea>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-controller="AdminLessons" asp-action="Index" asp-route-courseId="@Model.CourseId" class="btn btn-light border rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-primary rounded-pill px-5 fw-semibold shadow-sm">
                        <i class="bi bi-check2 me-1"></i> Update Lesson
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
