@model CampusLearn.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Administrator Console Dashboard";
}

<div class="py-4">
    <!-- Admin Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-warning text-dark fw-bold px-3 py-1 rounded-pill">
                    <i class="bi bi-shield-lock-fill me-1"></i> Admin Console
                </span>
                <span class="text-muted small">Campus Administration Portal</span>
            </div>
            <h1 class="fw-bold text-dark mb-0">System Overview & Management</h1>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="AdminCourses" asp-action="Create" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> New Course
            </a>
            <a asp-controller="AdminLessons" asp-action="Create" class="btn btn-outline-primary rounded-pill px-4 fw-semibold">
                <i class="bi bi-journal-plus me-1"></i> New Lesson
            </a>
            <a asp-controller="Account" asp-action="AdminChangePassword" class="btn btn-outline-secondary rounded-pill px-3 fw-semibold">
                <i class="bi bi-shield-lock me-1"></i> Change Password
            </a>
        </div>
    </div>

    <!-- Quick Navigation Bar for Admin Sections -->
    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white mb-5">
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="AdminCourses" asp-action="Index" class="btn btn-light rounded-pill px-3 fw-semibold border">
                <i class="bi bi-collection-play text-primary me-1"></i> Courses (@Model.TotalCourses)
            </a>
            <a asp-controller="AdminLessons" asp-action="Index" class="btn btn-light rounded-pill px-3 fw-semibold border">
                <i class="bi bi-journal-text text-primary me-1"></i> Lessons (@Model.TotalLessons)
            </a>
            <a asp-controller="AdminQuizzes" asp-action="Index" class="btn btn-light rounded-pill px-3 fw-semibold border">
                <i class="bi bi-patch-question text-primary me-1"></i> Quizzes (@Model.TotalQuizzes)
            </a>
            <a asp-controller="AdminLearners" asp-action="Index" class="btn btn-light rounded-pill px-3 fw-semibold border">
                <i class="bi bi-people text-primary me-1"></i> Learners (@Model.TotalLearners)
            </a>
            <a asp-controller="AdminEnrollments" asp-action="Index" class="btn btn-light rounded-pill px-3 fw-semibold border">
                <i class="bi bi-card-checklist text-primary me-1"></i> Enrollments (@Model.TotalEnrollments)
            </a>
            <a asp-controller="AdminQuizResults" asp-action="Index" class="btn btn-light rounded-pill px-3 fw-semibold border">
                <i class="bi bi-award text-primary me-1"></i> Quiz Submissions (@Model.TotalQuizAttempts)
            </a>
            <a asp-controller="AdminContactMessages" asp-action="Index" class="btn btn-light rounded-pill px-3 fw-semibold border">
                <i class="bi bi-envelope text-primary me-1"></i> Inquiries (@Model.TotalContactMessages)
            </a>
        </div>
    </div>

    <!-- Metric Cards -->
    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Active Courses</span>
                    <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary">
                        <i class="bi bi-collection-play"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-0">@Model.TotalCourses</h2>
                <a asp-controller="AdminCourses" asp-action="Index" class="small text-primary text-decoration-none mt-2 d-inline-block">Manage Courses &rarr;</a>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Registered Learners</span>
                    <div class="stat-icon-wrapper bg-success bg-opacity-10 text-success">
                        <i class="bi bi-people"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-0">@Model.TotalLearners</h2>
                <a asp-controller="AdminLearners" asp-action="Index" class="small text-success text-decoration-none mt-2 d-inline-block">View Students &rarr;</a>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Course Enrollments</span>
                    <div class="stat-icon-wrapper bg-warning bg-opacity-10 text-warning">
                        <i class="bi bi-journal-check"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-0">@Model.TotalEnrollments</h2>
                <a asp-controller="AdminEnrollments" asp-action="Index" class="small text-warning text-decoration-none mt-2 d-inline-block">Manage Enrollments &rarr;</a>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="stat-card">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <span class="text-muted small fw-semibold">Quiz Assessments</span>
                    <div class="stat-icon-wrapper bg-info bg-opacity-10 text-info">
                        <i class="bi bi-patch-question"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-0">@Model.TotalQuizAttempts</h2>
                <a asp-controller="AdminQuizResults" asp-action="Index" class="small text-info text-decoration-none mt-2 d-inline-block">Inspect Scores &rarr;</a>
            </div>
        </div>
    </div>

    <!-- Recent Activity Tables -->
    <div class="row g-4">
        <!-- Recent Courses -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-collection text-primary me-2"></i> Recent Courses
                    </h5>
                    <a asp-controller="AdminCourses" asp-action="Index" class="small text-primary text-decoration-none">View All</a>
                </div>

                @if (Model.RecentCourses.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Title</th>
                                    <th>Category</th>
                                    <th>Duration</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.RecentCourses)
                                {
                                    <tr>
                                        <td class="fw-semibold">@c.Title</td>
                                        <td><span class="badge bg-primary-subtle text-primary">@(c.Category ?? "General")</span></td>
                                        <td><span class="badge bg-light text-dark border">@(c.Duration ?? "Self-paced")</span></td>
                                        <td class="text-end">
                                            <a asp-controller="AdminCourses" asp-action="Edit" asp-route-id="@c.CourseId" class="btn btn-sm btn-light border px-2 py-1">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No courses created yet.</p>
                }
            </div>
        </div>

        <!-- Recent Enrollments -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold text-dark mb-0">
                        <i class="bi bi-card-checklist text-success me-2"></i> Recent Enrollments
                    </h5>
                    <a asp-controller="AdminEnrollments" asp-action="Index" class="small text-primary text-decoration-none">View All</a>
                </div>

                @if (Model.RecentEnrollments.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Learner</th>
                                    <th>Course</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.RecentEnrollments)
                                {
                                    <tr>
                                        <td class="fw-semibold">@(e.User?.FullName ?? e.User?.Email ?? "User")</td>
                                        <td>@e.Course?.Title</td>
                                        <td class="text-muted">@e.EnrollmentDate.ToString("MMM dd, yyyy")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0">No enrollments yet.</p>
                }
            </div>
        </div>
    </div>
</div>
