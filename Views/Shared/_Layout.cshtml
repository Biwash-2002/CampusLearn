<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CampusLearn | Course Delivery & Progress Portal</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5.3 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CampusLearn.styles.css" asp-append-version="true" />
    
    <!-- Theme Script (Prevents Flickering) -->
    <script>
        (function () {
            const savedTheme = localStorage.getItem('campuslearn-theme') || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="sticky-top bg-white border-bottom shadow-sm nav-header">
        <nav class="navbar navbar-expand-lg navbar-light py-3">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center fw-bold fs-4 text-primary" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon me-2 d-flex align-items-center justify-content-center bg-primary text-white rounded-3">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <span>Campus<span class="text-gradient">Learn</span></span>
                </a>
                
                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                @{
                    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
                }
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                        <li class="nav-item">
                            <a class="nav-link fw-medium px-3 rounded-pill @(currentController == "Home" && currentAction == "Index" ? "active text-primary fw-bold" : "")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium px-3 rounded-pill @(currentController == "Courses" ? "active text-primary fw-bold" : "")" asp-controller="Courses" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Courses
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium px-3 rounded-pill @(currentController == "Home" && currentAction == "About" ? "active text-primary fw-bold" : "")" asp-controller="Home" asp-action="About">
                                <i class="bi bi-info-circle me-1"></i> About
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-medium px-3 rounded-pill @(currentController == "Home" && currentAction == "Contact" ? "active text-primary fw-bold" : "")" asp-controller="Home" asp-action="Contact">
                                <i class="bi bi-envelope me-1"></i> Contact
                            </a>
                        </li>
                    </ul>
                    
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
        <div class="container my-4">
            <partial name="_AlertMessages" />
        </div>
        @RenderBody()
    </main>

    <footer class="footer bg-dark text-white pt-5 pb-4 mt-auto">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4 col-md-6">
                    <div class="d-flex align-items-center fw-bold fs-4 text-white mb-3">
                        <div class="brand-icon me-2 d-flex align-items-center justify-content-center bg-primary text-white rounded-3">
                            <i class="bi bi-mortarboard-fill"></i>
                        </div>
                        <span>Campus<span class="text-primary-light">Learn</span></span>
                    </div>
                    <p class="text-secondary small pe-lg-4">
                        CampusLearn is a modern, web-based course delivery and progress tracking portal designed to empower college learners and educators with interactive learning experiences.
                    </p>
                    <div class="d-flex gap-3 text-secondary">
                        <a href="#" class="text-secondary fs-5 hover-primary"><i class="bi bi-github"></i></a>
                        <a href="#" class="text-secondary fs-5 hover-primary"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-secondary fs-5 hover-primary"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>
                
                <div class="col-lg-2 col-md-6">
                    <h6 class="fw-bold text-uppercase tracking-wider mb-3 text-light">Quick Links</h6>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index" class="text-secondary text-decoration-none hover-primary">Home</a></li>
                        <li><a asp-controller="Courses" asp-action="Index" class="text-secondary text-decoration-none hover-primary">Course Catalogue</a></li>
                        <li><a asp-controller="Home" asp-action="About" class="text-secondary text-decoration-none hover-primary">About Platform</a></li>
                        <li><a asp-controller="Home" asp-action="Contact" class="text-secondary text-decoration-none hover-primary">Contact Support</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase tracking-wider mb-3 text-light">Portals</h6>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2">
                        <li><a asp-controller="Account" asp-action="Login" class="text-secondary text-decoration-none hover-primary"><i class="bi bi-person me-1"></i> Learner Login</a></li>
                        <li><a asp-controller="Account" asp-action="Register" class="text-secondary text-decoration-none hover-primary"><i class="bi bi-person-plus me-1"></i> Learner Register</a></li>
                        <li><a asp-controller="Account" asp-action="AdminLogin" class="text-warning text-decoration-none"><i class="bi bi-shield-lock me-1"></i> Administrator Portal</a></li>
                    </ul>
                </div>
                
                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-uppercase tracking-wider mb-3 text-light">College Semester Project</h6>
                    <p class="text-secondary small mb-2">
                        Built with ASP.NET Core 10 MVC, EF Core, SQL/SQLite & Bootstrap 5.
                    </p>
                    <div class="badge bg-primary bg-opacity-25 text-primary-light border border-primary border-opacity-50 p-2 rounded-3 w-100 text-start">
                        <i class="bi bi-check-circle-fill me-1"></i> Live & Fully Functional
                    </div>
                </div>
            </div>
            
            <hr class="border-secondary opacity-25 my-4" />
            
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center text-secondary small">
                <div>&copy; @DateTime.UtcNow.Year CampusLearn Portal. All rights reserved.</div>
                <div class="mt-2 mt-md-0">Designed for College Semester Project Submission.</div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
