@using Microsoft.AspNetCore.Identity
@using CampusLearn.Models
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<ul class="navbar-nav align-items-center gap-2">
@if (SignInManager.IsSignedIn(User))
{
    @if (User.IsInRole("Administrator"))
    {
        <li class="nav-item">
            <a class="nav-link fw-semibold text-warning d-flex align-items-center" asp-controller="Admin" asp-action="Dashboard">
                <i class="bi bi-shield-lock-fill me-1"></i> Admin Panel
            </a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link fw-semibold d-flex align-items-center" asp-controller="Learner" asp-action="Dashboard">
                <i class="bi bi-speedometer2 me-1 text-primary"></i> Dashboard
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold d-flex align-items-center" asp-controller="Learner" asp-action="MyCourses">
                <i class="bi bi-journal-bookmark me-1 text-primary"></i> My Courses
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-semibold d-flex align-items-center" asp-controller="Learner" asp-action="Progress">
                <i class="bi bi-graph-up-arrow me-1 text-primary"></i> Progress
            </a>
        </li>
    }

    <li class="nav-item dropdown">
        <a class="nav-link dropdown-toggle btn btn-light rounded-pill px-3 py-1 d-flex align-items-center border" href="#" id="userMenu" role="button" data-bs-toggle="dropdown" aria-expanded="false">
            <i class="bi bi-person-circle fs-5 text-primary me-2"></i>
            <span class="fw-semibold">@(User.Identity?.Name?.Split('@')[0] ?? "User")</span>
        </a>
        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-3 mt-2" aria-labelledby="userMenu">
            <li class="dropdown-header">
                <div class="fw-bold text-dark">@User.Identity?.Name</div>
                <div class="small text-muted">Role: @(User.IsInRole("Administrator") ? "Administrator" : "Learner")</div>
            </li>
            <li><hr class="dropdown-divider"></li>
            @if (User.IsInRole("Administrator"))
            {
                <li><a class="dropdown-item py-2" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-grid-1x2 me-2 text-primary"></i> Admin Dashboard</a></li>
                <li><a class="dropdown-item py-2" asp-controller="AdminCourses" asp-action="Index"><i class="bi bi-collection-play me-2 text-primary"></i> Manage Courses</a></li>
                <li><a class="dropdown-item py-2" asp-controller="AdminLearners" asp-action="Index"><i class="bi bi-people me-2 text-primary"></i> Manage Learners</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Account" asp-action="AdminChangePassword"><i class="bi bi-shield-lock me-2 text-warning"></i> Change Password</a></li>
            }
            else
            {
                <li><a class="dropdown-item py-2" asp-controller="Learner" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2 text-primary"></i> My Dashboard</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Learner" asp-action="MyCourses"><i class="bi bi-journal-check me-2 text-primary"></i> Enrolled Courses</a></li>
                <li><a class="dropdown-item py-2" asp-controller="Learner" asp-action="Progress"><i class="bi bi-award me-2 text-primary"></i> Learning Analytics</a></li>
            }
            <li><hr class="dropdown-divider"></li>
            <li>
                <form class="px-2" asp-controller="Account" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="dropdown-item rounded-2 text-danger py-2 d-flex align-items-center">
                        <i class="bi bi-box-arrow-right me-2"></i> Log Out
                    </button>
                </form>
            </li>
        </ul>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link fw-semibold" asp-controller="Account" asp-action="Login">
            <i class="bi bi-box-arrow-in-right me-1"></i> Log In
        </a>
    </li>
    <li class="nav-item">
        <a class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" asp-controller="Account" asp-action="Register">
            Sign Up Free
        </a>
    </li>
}
</ul>
