@model CampusLearn.Models.QuizResult
@{
    ViewData["Title"] = $"Delete Quiz Submission #{Model.QuizResultId}";
    var percent = Model.TotalQuestions > 0 ? (int)Math.Round((double)Model.Score / Model.TotalQuestions * 100) : 0;
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            <div class="rounded-circle bg-danger bg-opacity-10 text-danger mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 70px; height: 70px; font-size: 2rem;">
                <i class="bi bi-trash3-fill"></i>
            </div>

            <h3 class="fw-bold text-dark mb-2">Delete Quiz Submission</h3>
            <p class="text-muted mb-4">
                Are you sure you want to permanently delete this quiz submission record?
            </p>

            <!-- Submission Summary -->
            <div class="card bg-light border p-3 rounded-3 mb-4 text-start small">
                <div class="fw-bold text-dark mb-2"><i class="bi bi-info-circle me-1 text-primary"></i> Submission Details:</div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Learner:</span>
                    <span class="fw-semibold text-dark">@(Model.User?.FullName ?? Model.User?.Email)</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Course:</span>
                    <span class="fw-semibold text-dark">@Model.Quiz.Course.Title</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Quiz:</span>
                    <span class="fw-semibold text-dark">@Model.Quiz.Title</span>
                </div>
                <div class="d-flex justify-content-between py-1 border-bottom">
                    <span class="text-muted">Score:</span>
                    <span class="fw-semibold text-dark">@Model.Score / @Model.TotalQuestions (@percent%)</span>
                </div>
                <div class="d-flex justify-content-between py-1">
                    <span class="text-muted">Attempt Date:</span>
                    <span class="fw-semibold text-dark">@Model.AttemptDate.ToString("MMMM dd, yyyy HH:mm")</span>
                </div>
            </div>

            <form asp-controller="AdminQuizResults" asp-action="Delete" asp-route-id="@Model.QuizResultId" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="AdminQuizResults" asp-action="Index" class="btn btn-light border rounded-pill px-4">
                        Cancel
                    </a>
                    <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold shadow-sm">
                        Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
