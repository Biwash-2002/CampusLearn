@model CampusLearn.ViewModels.LessonViewViewModel
@{
    ViewData["Title"] = $"{Model.Lesson.Title} - {Model.Course.Title}";
}

<div class="py-4">
    <!-- Breadcrumb & Top Bar -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-controller="Learner" asp-action="MyCourses" class="text-decoration-none"><i class="bi bi-journal-bookmark me-1"></i> My Courses</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Course.CourseId" class="text-decoration-none">@Model.Course.Title</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Lesson @Model.Lesson.LessonOrder</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-dark mb-0">Lesson @Model.Lesson.LessonOrder: @Model.Lesson.Title</h2>
        </div>

        <div class="mt-3 mt-md-0 d-flex gap-2 align-items-center">
            @if (Model.Completed)
            {
                <span class="badge bg-success px-3 py-2 rounded-pill fs-6 d-flex align-items-center">
                    <i class="bi bi-check-circle-fill me-2"></i> Completed
                </span>
            }
            else
            {
                <form asp-controller="Lessons" asp-action="Complete" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="lessonId" value="@Model.Lesson.LessonId" />
                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">
                        <i class="bi bi-check2-circle me-1"></i> Mark as Completed
                    </button>
                </form>
            }
            <a asp-controller="Learner" asp-action="MyCourses" class="btn btn-outline-secondary rounded-pill px-3 btn-sm">
                <i class="bi bi-arrow-left me-1"></i> My Courses
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Lesson Content Area (Left) -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white mb-4">
                <div class="lesson-content text-dark" style="line-height: 1.8;">
                    @Html.Raw(Model.Lesson.Content)
                </div>

                <!-- Navigation between lessons and quiz -->
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-5 pt-4 border-top">
                    @if (Model.PreviousLesson != null)
                    {
                        <a asp-controller="Lessons" asp-action="Details" asp-route-id="@Model.PreviousLesson.LessonId" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-arrow-left me-1"></i> Previous Lesson
                        </a>
                    }
                    else
                    {
                        <div></div>
                    }

                    <div class="d-flex gap-2">
                        @if (Model.NextLesson != null)
                        {
                            <a asp-controller="Lessons" asp-action="Details" asp-route-id="@Model.NextLesson.LessonId" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                Next Lesson <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        }
                        else if (Model.CourseQuizzes.Any())
                        {
                            <a asp-controller="Quizzes" asp-action="Take" asp-route-id="@Model.CourseQuizzes.First().QuizId" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm text-dark">
                                <i class="bi bi-patch-question-fill me-1"></i> Take Course Quiz
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Learner" asp-action="MyCourses" class="btn btn-success rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check2-all me-1"></i> Back to My Courses
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Syllabus Playlist & Quiz Access (Right) -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white sticky-top" style="top: 90px;">
                <div class="card-header bg-white border-bottom p-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="fw-bold text-dark mb-0">
                            <i class="bi bi-journal-text text-primary me-2"></i> Course Progress
                        </h6>
                        <span class="badge bg-primary rounded-pill">@Model.ProgressPercentage%</span>
                    </div>
                    <div class="progress mb-2" style="height: 8px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @Model.ProgressPercentage%"></div>
                    </div>
                    <div class="small text-muted d-flex justify-content-between">
                        <span>@Model.CompletedLessonsCount of @Model.TotalLessonsCount lessons completed</span>
                    </div>
                </div>

                <!-- Lessons List -->
                <div class="list-group list-group-flush" style="max-height: 360px; overflow-y: auto;">
                    @if (Model.AllCourseLessons.Any())
                    {
                        foreach (var l in Model.AllCourseLessons)
                        {
                            <a asp-controller="Lessons" asp-action="Details" asp-route-id="@l.LessonId" 
                               class="list-group-item list-group-item-action p-3 d-flex align-items-center justify-content-between @(l.IsCurrent ? "bg-primary-subtle text-primary fw-bold" : "")">
                                <div class="d-flex align-items-center me-2">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center me-2 @(l.Completed ? "bg-success text-white" : (l.IsCurrent ? "bg-primary text-white" : "bg-light border text-muted"))" style="width: 28px; height: 28px; font-size: 0.8rem; flex-shrink: 0;">
                                        @if (l.Completed)
                                        {
                                            <i class="bi bi-check-lg"></i>
                                        }
                                        else
                                        {
                                            <span>@l.LessonOrder</span>
                                        }
                                    </div>
                                    <span class="small line-clamp-1">@l.Title</span>
                                </div>
                                @if (l.IsCurrent)
                                {
                                    <span class="badge bg-primary rounded-pill small">Active</span>
                                }
                            </a>
                        }
                    }
                    else
                    {
                        <div class="p-3 text-center text-muted small">No lessons in this course.</div>
                    }
                </div>

                <!-- Course Quizzes Section -->
                <div class="card-header bg-light border-top border-bottom p-3">
                    <h6 class="fw-bold text-dark mb-0">
                        <i class="bi bi-patch-question-fill text-warning me-2"></i> Course Assessment
                    </h6>
                </div>
                <div class="p-3">
                    @if (Model.CourseQuizzes.Any())
                    {
                        <div class="d-flex flex-column gap-2">
                            @foreach (var q in Model.CourseQuizzes)
                            {
                                <div class="p-2.5 rounded-3 border bg-light d-flex justify-content-between align-items-center">
                                    <div>
                                        <div class="fw-semibold small text-dark">@q.Title</div>
                                        <div class="text-muted small" style="font-size: 0.75rem;">
                                            @(q.Questions?.Count ?? 0) questions
                                        </div>
                                    </div>
                                    <a asp-controller="Quizzes" asp-action="Take" asp-route-id="@q.QuizId" class="btn btn-sm btn-primary rounded-pill px-3 fw-semibold">
                                        Take Quiz
                                    </a>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-0 text-center py-2">
                            <i class="bi bi-info-circle me-1"></i> No quiz available for this course yet.
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
