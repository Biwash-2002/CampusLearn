@model CampusLearn.ViewModels.LearnerProgressViewModel
@{
    ViewData["Title"] = "My Learning Progress & Analytics";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">Learning Progress & Analytics</h1>
            <p class="text-muted mb-0">Detailed breakdown of your completed modules and learning progress</p>
        </div>
    </div>

    <!-- Overview Stats -->
    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="stat-card">
                <span class="text-muted small fw-semibold">Overall Completion</span>
                <h2 class="fw-bold text-primary my-2">@Model.OverallProgressPercentage%</h2>
                <div class="progress" style="height: 6px;">
                    <div class="progress-bar" style="width: @Model.OverallProgressPercentage%"></div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <span class="text-muted small fw-semibold">Completed Lessons</span>
                <h2 class="fw-bold text-success my-2">@Model.TotalLessonsCompleted</h2>
                <span class="text-muted small">Academic units finished</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <span class="text-muted small fw-semibold">Quiz Assessments</span>
                <h2 class="fw-bold text-warning my-2">@Model.TotalQuizzesTaken</h2>
                <span class="text-muted small">Evaluations submitted</span>
            </div>
        </div>

        <div class="col-md-3">
            <div class="stat-card">
                <span class="text-muted small fw-semibold">Mean Performance Score</span>
                <h2 class="fw-bold text-info my-2">@Model.OverallAverageScore%</h2>
                <span class="text-muted small">Cumulative quiz grade</span>
            </div>
        </div>
    </div>

    <!-- Per-Course Details Breakdown -->
    <h4 class="fw-bold text-dark mb-3">Course-by-Course Progress</h4>

    @if (Model.CourseDetails.Any())
    {
        <div class="d-flex flex-column gap-4">
            @foreach (var course in Model.CourseDetails)
            {
                <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
                    <div class="card-header bg-white border-bottom p-4 d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                @if (!string.IsNullOrEmpty(course.Category))
                                {
                                    <span class="badge bg-primary-subtle text-primary rounded-pill small">@course.Category</span>
                                }
                                @if (course.Status == "Completed")
                                {
                                    <span class="badge bg-success rounded-pill small"><i class="bi bi-check-circle-fill me-1"></i> Completed</span>
                                }
                            </div>
                            <h5 class="fw-bold text-dark mb-0">@course.CourseTitle</h5>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <div class="text-end">
                                <div class="fw-bold text-primary fs-5">@course.ProgressPercentage%</div>
                                <div class="text-muted small">Course Progress</div>
                            </div>
                            <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                View Course
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light small text-muted">
                                    <tr>
                                        <th style="width: 80px;">#</th>
                                        <th>Lesson Title</th>
                                        <th>Completion Status</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var lesson in course.Lessons)
                                    {
                                        <tr>
                                            <td class="fw-semibold text-muted">Lesson @lesson.LessonOrder</td>
                                            <td>
                                                <div class="fw-semibold text-dark">@lesson.LessonTitle</div>
                                            </td>
                                            <td>
                                                @if (lesson.Completed)
                                                {
                                                    <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">
                                                        <i class="bi bi-check2-circle me-1"></i> Completed @(lesson.CompletedAt?.ToString("MMM dd") ?? "")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-muted border px-2 py-1 rounded-pill">
                                                        Not Completed
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a asp-controller="Lessons" asp-action="Details" asp-route-id="@lesson.LessonId" class="btn btn-sm btn-light border rounded-pill px-3">
                                                    @(lesson.Completed ? "Review" : "Open") <i class="bi bi-chevron-right ms-1"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <p class="text-muted mb-0">No progress data available yet. Enroll in courses to start recording progress.</p>
        </div>
    }
</div>
