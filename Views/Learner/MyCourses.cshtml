@model List<CampusLearn.ViewModels.EnrolledCourseProgressViewModel>
@{
    ViewData["Title"] = "My Enrolled Courses";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <h1 class="fw-bold text-dark mb-1">My Enrolled Courses</h1>
            <p class="text-muted mb-0">Continue your active learning journeys and track your completion status</p>
        </div>
        <div class="mt-3 mt-md-0">
            <a asp-controller="Courses" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Enroll in New Course
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @foreach (var course in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden bg-white course-card d-flex flex-column">
                        <div class="course-img-wrapper position-relative">
                            <img src="@(string.IsNullOrEmpty(course.ImageUrl) ? "https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600&auto=format&fit=crop&q=80" : course.ImageUrl)" 
                                 class="card-img-top course-img" alt="@course.CourseTitle"
                                 onerror="this.src='https://images.unsplash.com/photo-1516321318423-f06f85e504b3?w=600&auto=format&fit=crop&q=80'">
                            @if (!string.IsNullOrEmpty(course.Category))
                            {
                                <span class="badge bg-primary position-absolute top-0 start-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                    @course.Category
                                </span>
                            }
                            @if (course.Status == "Completed")
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-3 px-3 py-2 rounded-pill shadow-sm">
                                    <i class="bi bi-check-circle-fill me-1"></i> Completed
                                </span>
                            }
                        </div>

                        <div class="card-body p-4 d-flex flex-column flex-grow-1">
                            <h5 class="card-title fw-bold text-dark mb-2">@course.CourseTitle</h5>
                            <p class="card-text text-muted small line-clamp-2 mb-3">@course.CourseDescription</p>

                            <div class="mt-auto">
                                <div class="d-flex justify-content-between align-items-center small text-muted mb-1">
                                    <span>Course Progress</span>
                                    <span class="fw-bold text-dark">@course.ProgressPercentage%</span>
                                </div>
                                <div class="progress mb-3" style="height: 8px;">
                                    <div class="progress-bar" role="progressbar" style="width: @course.ProgressPercentage%"></div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center small text-muted mb-3">
                                    <span><i class="bi bi-check2-circle text-primary me-1"></i> @course.CompletedLessons/@course.TotalLessons lessons</span>
                                    <span><i class="bi bi-calendar3 me-1"></i> @course.EnrollmentDate.ToString("MMM dd")</span>
                                </div>

                                @if (course.LatestQuizResult != null)
                                {
                                    <div class="p-2 mb-3 bg-light rounded-3 border d-flex justify-content-between align-items-center small">
                                        <span class="text-success fw-semibold"><i class="bi bi-trophy me-1"></i> Score: @course.LatestQuizResult.Score/@course.LatestQuizResult.TotalQuestions</span>
                                        <a asp-controller="Quizzes" asp-action="Result" asp-route-id="@course.LatestQuizResult.QuizResultId" class="text-primary text-decoration-none fw-semibold">
                                            Result &rarr;
                                        </a>
                                    </div>
                                }

                                <div class="d-grid gap-2">
                                    @if (course.NextLessonId.HasValue)
                                    {
                                        <a asp-controller="Lessons" asp-action="Details" asp-route-id="@course.NextLessonId" class="btn btn-primary rounded-pill py-2 fw-semibold shadow-sm">
                                            @(course.Status == "Completed" ? "Review Lessons" : "Resume Course") <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-outline-primary rounded-pill py-2 fw-semibold">
                                            View Outline
                                        </a>
                                    }

                                    @if (course.AvailableQuizId.HasValue && course.LatestQuizResult == null)
                                    {
                                        <a asp-controller="Quizzes" asp-action="Take" asp-route-id="@course.AvailableQuizId" class="btn btn-outline-warning text-dark rounded-pill py-1.5 btn-sm fw-semibold">
                                            <i class="bi bi-patch-question me-1"></i> Take Quiz Assessment
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-5">
            <div class="stat-icon-wrapper bg-primary bg-opacity-10 text-primary mx-auto mb-3" style="width: 70px; height: 70px;">
                <i class="bi bi-journal-x fs-2"></i>
            </div>
            <h4 class="fw-bold text-dark">No Enrolled Courses</h4>
            <p class="text-muted max-w-500 mx-auto mb-4">You haven't enrolled in any courses yet. Discover our curriculum to begin learning today.</p>
            <div>
                <a asp-controller="Courses" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-compass me-1"></i> Browse Course Catalogue
                </a>
            </div>
        </div>
    }
</div>
