@model CampusLearn.ViewModels.LearnerDashboardViewModel
@{
    ViewData["Title"] = "Learner Dashboard";
}

<div class="py-4">
    <!-- Welcome Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill">
                    <i class="bi bi-mortarboard-fill me-1"></i> Student Portal
                </span>
            </div>
            <h1 class="fw-bold text-dark mb-1">Welcome back, @(string.IsNullOrWhiteSpace(Model.User.FullName) ? Model.User.UserName : Model.User.FullName)! 👋</h1>
            <p class="text-muted mb-0">Track your enrolled courses, lesson progress, and quiz assessments in real time.</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a asp-controller="Learner" asp-action="MyCourses" class="btn btn-outline-secondary rounded-pill px-4 fw-semibold">
                <i class="bi bi-journal-bookmark me-1"></i> My Courses
            </a>
            <a asp-controller="Courses" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-compass me-1"></i> Course Catalogue
            </a>
        </div>
    </div>

    <!-- Stat Metrics Cards -->
    <div class="row g-4 mb-4">
        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small fw-semibold">Enrolled Courses</span>
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-journal-bookmark-fill fs-5"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-1">@Model.TotalEnrolledCourses</h2>
                <span class="text-muted small">@Model.InProgressCoursesCount in progress</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small fw-semibold">Completed Courses</span>
                    <div class="rounded-circle bg-success bg-opacity-10 text-success p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-patch-check-fill fs-5"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-1">@Model.CompletedCoursesCount</h2>
                <span class="text-success small fw-semibold"><i class="bi bi-check-all"></i> Curriculum completed</span>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small fw-semibold">Overall Progress</span>
                    <div class="rounded-circle bg-info bg-opacity-10 text-info p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-pie-chart-fill fs-5"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-1">@Model.OverallProgressPercentage%</h2>
                <div class="progress mt-2" style="height: 6px;">
                    <div class="progress-bar bg-info" role="progressbar" style="width: @Model.OverallProgressPercentage%"></div>
                </div>
            </div>
        </div>

        <div class="col-sm-6 col-lg-3">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <span class="text-muted small fw-semibold">Avg Quiz Score</span>
                    <div class="rounded-circle bg-warning bg-opacity-10 text-warning p-2 d-flex align-items-center justify-content-center" style="width: 44px; height: 44px;">
                        <i class="bi bi-trophy-fill fs-5"></i>
                    </div>
                </div>
                <h2 class="fw-bold text-dark mb-1">@(Model.RecentQuizResults.Any() ? $"{Model.AverageQuizScore}%" : "N/A")</h2>
                <span class="text-muted small">@Model.TotalQuizzesPassed quiz(zes) passed</span>
            </div>
        </div>
    </div>

    <!-- Active Learning Progress Section -->
    <div class="row g-4 mb-5">
        <div class="col-lg-8">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold text-dark mb-0">
                    <i class="bi bi-play-circle text-primary me-2"></i> Recent Enrolled Courses
                </h4>
                <a asp-controller="Learner" asp-action="MyCourses" class="text-primary small fw-semibold text-decoration-none">
                    View All (@Model.TotalEnrolledCourses) <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            @if (Model.EnrolledCourses.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var course in Model.EnrolledCourses)
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-3">
                                <div>
                                    <div class="d-flex align-items-center gap-2 mb-1">
                                        @if (!string.IsNullOrEmpty(course.Category))
                                        {
                                            <span class="badge bg-primary-subtle text-primary px-2.5 py-1 rounded-pill small">@course.Category</span>
                                        }
                                        @if (!string.IsNullOrEmpty(course.Duration))
                                        {
                                            <span class="badge bg-light text-muted border px-2.5 py-1 rounded-pill small">@course.Duration</span>
                                        }
                                        @if (course.Status == "Completed" || course.ProgressPercentage >= 100)
                                        {
                                            <span class="badge bg-success px-2.5 py-1 rounded-pill small"><i class="bi bi-check-circle me-1"></i> Completed</span>
                                        }
                                    </div>
                                    <h5 class="fw-bold text-dark mb-1">@course.CourseTitle</h5>
                                    <div class="text-muted small">
                                        <i class="bi bi-journal-check me-1 text-primary"></i> @course.CompletedLessons of @course.TotalLessons lessons completed
                                        <span class="mx-2">•</span>
                                        <i class="bi bi-calendar3 me-1"></i> Enrolled: @course.EnrollmentDate.ToString("MMM dd, yyyy")
                                    </div>
                                </div>

                                <div class="text-md-end flex-shrink-0 d-flex flex-wrap gap-2">
                                    @if (course.NextLessonId.HasValue)
                                    {
                                        <a asp-controller="Lessons" asp-action="Details" asp-route-id="@course.NextLessonId" class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold shadow-sm">
                                            @(course.Status == "Completed" ? "Review Lessons" : "Continue Learning") <i class="bi bi-play-fill ms-1"></i>
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Courses" asp-action="Details" asp-route-id="@course.CourseId" class="btn btn-outline-primary rounded-pill px-4 btn-sm fw-semibold">
                                            Course Details
                                        </a>
                                    }

                                    @if (course.AvailableQuizId.HasValue && course.LatestQuizResult == null)
                                    {
                                        <a asp-controller="Quizzes" asp-action="Take" asp-route-id="@course.AvailableQuizId" class="btn btn-warning text-dark rounded-pill px-3 btn-sm fw-semibold shadow-sm">
                                            <i class="bi bi-patch-question me-1"></i> Take Quiz
                                        </a>
                                    }
                                </div>
                            </div>

                            <!-- Progress Bar -->
                            <div class="progress mb-2" style="height: 8px;">
                                <div class="progress-bar @(course.ProgressPercentage >= 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @course.ProgressPercentage%" aria-valuenow="@course.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>

                            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center text-muted small gap-1">
                                <span>Progress: <strong class="text-dark">@course.ProgressPercentage%</strong></span>
                                @if (course.LatestQuizResult != null)
                                {
                                    <span class="text-success fw-semibold">
                                        <i class="bi bi-trophy me-1"></i> Quiz Score: @course.LatestQuizResult.Score/@course.LatestQuizResult.TotalQuestions (@(course.LatestQuizResult.TotalQuestions > 0 ? Math.Round((double)course.LatestQuizResult.Score / course.LatestQuizResult.TotalQuestions * 100) : 0)%)
                                        <a asp-controller="Quizzes" asp-action="Result" asp-route-id="@course.LatestQuizResult.QuizResultId" class="ms-1 text-decoration-none">View &rarr;</a>
                                    </span>
                                }
                                else if (course.AvailableQuizId.HasValue)
                                {
                                    <span class="text-warning">
                                        <i class="bi bi-exclamation-circle me-1"></i> Quiz available (Not attempted yet)
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">No quiz assigned to this course</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                    <div class="rounded-circle bg-primary bg-opacity-10 text-primary mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 65px; height: 65px;">
                        <i class="bi bi-book fs-3"></i>
                    </div>
                    <h5 class="fw-bold text-dark">You are not enrolled in any courses yet</h5>
                    <p class="text-muted small max-w-500 mx-auto mb-4">Start learning by choosing from our catalogue of courses.</p>
                    <div>
                        <a asp-controller="Courses" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="bi bi-compass me-1"></i> Explore Courses Catalogue
                        </a>
                    </div>
                </div>
            }
        </div>

        <!-- Sidebar (Recent Quiz Results & Quick Actions) -->
        <div class="col-lg-4">
            <!-- Recent Quiz Performance -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white mb-4">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-clock-history text-primary me-2"></i> Recent Assessments
                </h5>
                @if (Model.RecentQuizResults.Any())
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var res in Model.RecentQuizResults)
                        {
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold small text-dark line-clamp-1">@res.QuizTitle</span>
                                    <span class="badge @(res.IsPassed ? "bg-success" : "bg-danger") rounded-pill">
                                        @res.Score/@res.TotalQuestions (@res.Percentage%)
                                    </span>
                                </div>
                                <div class="text-muted small line-clamp-1 mb-2">@res.CourseTitle</div>
                                <div class="d-flex justify-content-between align-items-center small">
                                    <span class="text-muted">@res.AttemptDate.ToString("MMM dd, yyyy")</span>
                                    <a asp-controller="Quizzes" asp-action="Result" asp-route-id="@res.QuizResultId" class="text-primary fw-semibold text-decoration-none">
                                        View Breakdown &rarr;
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted small mb-0 text-center py-3">
                        <i class="bi bi-info-circle me-1"></i> No quiz assessments completed yet.
                    </p>
                }
            </div>

            <!-- Recommended Courses -->
            @if (Model.RecommendedCourses.Any())
            {
                <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-stars text-primary me-2"></i> Explore More Courses
                    </h5>
                    <div class="d-flex flex-column gap-3">
                        @foreach (var rec in Model.RecommendedCourses)
                        {
                            <div class="border rounded-3 p-3 d-flex flex-column gap-2">
                                <div class="fw-semibold text-dark">@rec.Title</div>
                                <div class="text-muted small line-clamp-2">@rec.Description</div>
                                <a asp-controller="Courses" asp-action="Details" asp-route-id="@rec.CourseId" class="btn btn-outline-primary btn-sm rounded-pill mt-1">
                                    View Course Details
                                </a>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
