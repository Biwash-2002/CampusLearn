@model CampusLearn.ViewModels.AdminChangePasswordViewModel
@{
    ViewData["Title"] = "Change Administrator Password";
}

<div class="row justify-content-center py-5">
    <div class="col-md-8 col-lg-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <div class="p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="brand-icon mx-auto mb-3 rounded-3 d-flex align-items-center justify-content-center text-white bg-warning" style="width: 50px; height: 50px; font-size: 1.5rem; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%) !important;">
                        <i class="bi bi-shield-lock-fill"></i>
                    </div>
                    <h3 class="fw-bold text-dark">Change Password</h3>
                    <p class="text-muted small">Update your administrative credentials securely</p>
                </div>

                <form asp-controller="Account" asp-action="AdminChangePassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label fw-semibold small">Current Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                            <input asp-for="CurrentPassword" class="form-control bg-light border-start-0" placeholder="••••••••" autocomplete="current-password" required />
                        </div>
                        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold small">New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                            <input asp-for="NewPassword" class="form-control bg-light border-start-0" placeholder="••••••••" autocomplete="new-password" required />
                        </div>
                        <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        <div class="form-text small text-muted">Must be at least 6 characters with uppercase, lowercase, digit, and special character.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold small">Confirm New Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-check2-circle text-muted"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control bg-light border-start-0" placeholder="••••••••" autocomplete="new-password" required />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-grid gap-2 mb-3">
                        <button type="submit" class="btn btn-warning py-2 rounded-pill fw-bold text-dark shadow-sm">
                            <i class="bi bi-shield-check me-2"></i> Update Password
                        </button>
                        <a asp-controller="Admin" asp-action="Dashboard" class="btn btn-light rounded-pill py-2 border text-muted">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
