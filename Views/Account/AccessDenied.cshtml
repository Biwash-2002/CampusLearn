@{
    ViewData["Title"] = "Access Restricted";
}

<div class="row justify-content-center py-5 text-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm rounded-4 p-5 bg-white">
            <div class="stat-icon-wrapper bg-danger bg-opacity-10 text-danger mx-auto mb-4" style="width: 70px; height: 70px; font-size: 2rem;">
                <i class="bi bi-shield-x"></i>
            </div>
            <h2 class="fw-bold text-dark mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have permission to view or manage this restricted resource. If you believe this is an error, please log in with the appropriate administrative role.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-house me-1"></i> Home
                </a>
                <a asp-controller="Account" asp-action="AdminLogin" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-shield-lock me-1"></i> Admin Login
                </a>
            </div>
        </div>
    </div>
</div>
