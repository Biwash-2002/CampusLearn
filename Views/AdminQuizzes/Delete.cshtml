@model CampusLearn.Models.Quiz
@{
    ViewData["Title"] = $"Delete Quiz: {Model.Title}";
}

<div class="row justify-content-center py-5">
    <div class="col-md-7 col-lg-6">
        <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white text-center">
            <div class="stat-icon-wrapper bg-danger bg-opacity-10 text-danger mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
                <i class="bi bi-trash3-fill"></i>
            </div>
            <h3 class="fw-bold text-dark mb-2">Delete Quiz Confirmation</h3>
            <p class="text-muted mb-4">
                Are you sure you want to permanently delete the quiz <strong>@Model.Title</strong>? All associated questions and student quiz submissions will be permanently deleted.
            </p>

            <div class="card bg-light border p-3 rounded-3 mb-4 text-start small text-muted">
                <div><strong>Course:</strong> @Model.Course.Title</div>
                <div><strong>Questions count:</strong> @(Model.Questions?.Count ?? 0)</div>
                <div><strong>Completed attempts:</strong> @(Model.QuizResults?.Count ?? 0)</div>
            </div>

            <form asp-controller="AdminQuizzes" asp-action="Delete" asp-route-id="@Model.QuizId" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex justify-content-center gap-3">
                    <a asp-controller="AdminQuizzes" asp-action="Index" class="btn btn-light border rounded-pill px-4">Cancel</a>
                    <button type="submit" class="btn btn-danger rounded-pill px-5 fw-bold shadow-sm">
                        Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
