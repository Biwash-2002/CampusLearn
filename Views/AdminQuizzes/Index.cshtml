@model List<CampusLearn.Models.Quiz>
@{
    ViewData["Title"] = "Quiz Management";
    var courses = ViewBag.Courses as List<CampusLearn.Models.Course> ?? new List<CampusLearn.Models.Course>();
    int? selectedCourseId = ViewBag.CourseId as int?;
    var selectedCourse = ViewBag.SelectedCourse as CampusLearn.Models.Course;
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="Admin" asp-action="Dashboard" class="badge bg-warning text-dark text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Admin Console
                </a>
            </div>
            <h1 class="fw-bold text-dark mb-0">Quiz Management</h1>
            <p class="text-muted small mb-0">Create and manage course quizzes, multiple-choice questions, and answer keys.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="AdminQuizzes" asp-action="Create" asp-route-courseId="@selectedCourseId" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Create New Quiz
            </a>
        </div>
    </div>

    <!-- Course Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-auto">
                <label for="courseFilter" class="form-label fw-bold small text-muted mb-0">
                    <i class="bi bi-funnel me-1"></i> Filter by Course:
                </label>
            </div>
            <div class="col-md-5">
                <select id="courseFilter" name="courseId" class="form-select rounded-pill" onchange="this.form.submit()">
                    <option value="">-- All Courses (@Model.Count Total Quizzes) --</option>
                    @foreach (var c in courses)
                    {
                        if (selectedCourseId.HasValue && selectedCourseId.Value == c.CourseId)
                        {
                            <option value="@c.CourseId" selected="selected">@c.Title</option>
                        }
                        else
                        {
                            <option value="@c.CourseId">@c.Title</option>
                        }
                    }
                </select>
            </div>
            @if (selectedCourseId.HasValue)
            {
                <div class="col-md-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
                        <i class="bi bi-x-circle me-1"></i> Clear Filter
                    </a>
                </div>
            }
        </form>
    </div>

    <!-- Quizzes Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th style="width: 30%;">Quiz Title</th>
                        <th style="width: 25%;">Associated Course</th>
                        <th style="width: 15%;">Questions</th>
                        <th style="width: 15%;">Learner Attempts</th>
                        <th style="width: 15%;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a asp-controller="AdminQuizzes" asp-action="Details" asp-route-id="@item.QuizId" class="fw-bold text-dark text-decoration-none d-block">
                                        @item.Title
                                    </a>
                                    <div class="text-muted small text-truncate" style="max-width: 320px;">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided" : item.Description)
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 rounded-pill">
                                        <i class="bi bi-journal-bookmark me-1"></i>@item.Course.Title
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info-subtle text-info fw-bold px-2 py-1 rounded-pill">
                                        @(item.Questions?.Count ?? 0) Questions
                                    </span>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        <i class="bi bi-people me-1"></i>@(item.QuizResults?.Count ?? 0) attempts
                                    </span>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="AdminQuizzes" asp-action="Details" asp-route-id="@item.QuizId" class="btn btn-light border" title="Manage Questions & Details">
                                            <i class="bi bi-list-check text-primary me-1"></i> Manage
                                        </a>
                                        <a asp-controller="AdminQuizzes" asp-action="Edit" asp-route-id="@item.QuizId" class="btn btn-light border" title="Edit Quiz">
                                            <i class="bi bi-pencil text-warning"></i>
                                        </a>
                                        <a asp-controller="AdminQuizzes" asp-action="Delete" asp-route-id="@item.QuizId" class="btn btn-light border" title="Delete Quiz">
                                            <i class="bi bi-trash text-danger"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-patch-question display-4 text-muted d-block mb-3 opacity-50"></i>
                                <h5>No quizzes found</h5>
                                <p class="small text-muted mb-3">
                                    @(selectedCourse != null ? $"No quizzes found for course '{selectedCourse.Title}'." : "No quizzes created in the system yet.")
                                </p>
                                <a asp-controller="AdminQuizzes" asp-action="Create" asp-route-courseId="@selectedCourseId" class="btn btn-sm btn-primary rounded-pill px-4">
                                    <i class="bi bi-plus-lg me-1"></i> Create First Quiz
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
