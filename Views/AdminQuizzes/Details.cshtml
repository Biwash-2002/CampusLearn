@model CampusLearn.Models.Quiz
@{
    ViewData["Title"] = $"Quiz: {Model.Title}";
    var questions = Model.Questions?.OrderBy(q => q.QuestionId).ToList() ?? new List<CampusLearn.Models.Question>();
    var results = Model.QuizResults?.OrderByDescending(r => r.AttemptDate).ToList() ?? new List<CampusLearn.Models.QuizResult>();
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="AdminQuizzes" asp-action="Index" class="badge bg-secondary text-white text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Back to Quizzes
                </a>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                    @Model.Course.Title
                </span>
            </div>
            <h1 class="fw-bold text-dark mb-0">@Model.Title</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="AdminQuizzes" asp-action="AddQuestion" asp-route-quizId="@Model.QuizId" class="btn btn-success rounded-pill px-3 shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Add Question
            </a>
            <a asp-controller="AdminQuizzes" asp-action="Edit" asp-route-id="@Model.QuizId" class="btn btn-warning rounded-pill px-3 shadow-sm text-dark">
                <i class="bi bi-pencil me-1"></i> Edit Quiz
            </a>
            <a asp-controller="AdminQuizzes" asp-action="Delete" asp-route-id="@Model.QuizId" class="btn btn-outline-danger rounded-pill px-3">
                <i class="bi bi-trash me-1"></i> Delete Quiz
            </a>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-primary bg-opacity-10 text-primary p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-patch-question-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Total Questions</span>
                    <h4 class="fw-bold mb-0 text-dark">@questions.Count</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-info bg-opacity-10 text-info p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-people-fill fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Learner Attempts</span>
                    <h4 class="fw-bold mb-0 text-dark">@results.Count</h4>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white d-flex flex-row align-items-center gap-3">
                <div class="rounded-circle bg-success bg-opacity-10 text-success p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="bi bi-graph-up-arrow fs-4"></i>
                </div>
                <div>
                    <span class="text-muted small d-block">Average Score</span>
                    <h4 class="fw-bold mb-0 text-dark">
                        @(results.Any() ? $"{results.Average(r => r.TotalQuestions > 0 ? (r.Score * 100.0 / r.TotalQuestions) : 0):F1}%" : "N/A")
                    </h4>
                </div>
            </div>
        </div>
    </div>

    <!-- Quiz Info & Description -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
        <h5 class="fw-bold text-dark mb-2">Quiz Details</h5>
        <div class="row g-3">
            <div class="col-md-6">
                <span class="text-muted small d-block">Associated Course:</span>
                <span class="fw-semibold text-dark">@Model.Course.Title</span>
            </div>
            <div class="col-md-6">
                <span class="text-muted small d-block">Course Category:</span>
                <span class="badge bg-secondary-subtle text-secondary">@Model.Course.Category</span>
            </div>
            <div class="col-12">
                <span class="text-muted small d-block">Description:</span>
                <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(Model.Description) ? "No description provided for this quiz." : Model.Description)</p>
            </div>
        </div>
    </div>

    <!-- Questions Management Section -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden mb-4">
        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-bold text-dark mb-0">
                    <i class="bi bi-list-ol text-primary me-2"></i> Questions (@questions.Count)
                </h5>
                <p class="text-muted small mb-0">Manage multiple choice questions and answer keys for this quiz.</p>
            </div>
            <a asp-controller="AdminQuizzes" asp-action="AddQuestion" asp-route-quizId="@Model.QuizId" class="btn btn-sm btn-primary rounded-pill px-3 shadow-sm">
                <i class="bi bi-plus-lg me-1"></i> Add Question
            </a>
        </div>
        <div class="card-body p-0">
            @if (questions.Any())
            {
                <div class="list-group list-group-flush">
                    @for (int i = 0; i < questions.Count; i++)
                    {
                        var q = questions[i];
                        <div class="list-group-item p-4">
                            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                                <div>
                                    <span class="badge bg-dark text-white rounded-pill px-2.5 py-1 mb-2">
                                        Question @(i + 1)
                                    </span>
                                    <h6 class="fw-bold text-dark mb-0 fs-5">@q.QuestionText</h6>
                                </div>
                                <div class="btn-group btn-group-sm">
                                    <a asp-controller="AdminQuizzes" asp-action="EditQuestion" asp-route-id="@q.QuestionId" class="btn btn-outline-warning text-dark" title="Edit Question">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                    <a asp-controller="AdminQuizzes" asp-action="DeleteQuestion" asp-route-id="@q.QuestionId" class="btn btn-outline-danger" title="Delete Question">
                                        <i class="bi bi-trash me-1"></i> Delete
                                    </a>
                                </div>
                            </div>

                            <!-- Options Grid -->
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div class="p-2.5 rounded-3 border @(q.CorrectAnswer == "A" ? "border-success bg-success bg-opacity-10" : "bg-light") d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="badge @(q.CorrectAnswer == "A" ? "bg-success" : "bg-secondary") me-2">A</span>
                                            <span class="@(q.CorrectAnswer == "A" ? "fw-bold text-success" : "text-dark")">@q.OptionA</span>
                                        </div>
                                        @if (q.CorrectAnswer == "A")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                                <i class="bi bi-check-circle-fill me-1"></i> Correct
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-2.5 rounded-3 border @(q.CorrectAnswer == "B" ? "border-success bg-success bg-opacity-10" : "bg-light") d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="badge @(q.CorrectAnswer == "B" ? "bg-success" : "bg-secondary") me-2">B</span>
                                            <span class="@(q.CorrectAnswer == "B" ? "fw-bold text-success" : "text-dark")">@q.OptionB</span>
                                        </div>
                                        @if (q.CorrectAnswer == "B")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                                <i class="bi bi-check-circle-fill me-1"></i> Correct
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-2.5 rounded-3 border @(q.CorrectAnswer == "C" ? "border-success bg-success bg-opacity-10" : "bg-light") d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="badge @(q.CorrectAnswer == "C" ? "bg-success" : "bg-secondary") me-2">C</span>
                                            <span class="@(q.CorrectAnswer == "C" ? "fw-bold text-success" : "text-dark")">@q.OptionC</span>
                                        </div>
                                        @if (q.CorrectAnswer == "C")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                                <i class="bi bi-check-circle-fill me-1"></i> Correct
                                            </span>
                                        }
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="p-2.5 rounded-3 border @(q.CorrectAnswer == "D" ? "border-success bg-success bg-opacity-10" : "bg-light") d-flex align-items-center justify-content-between">
                                        <div>
                                            <span class="badge @(q.CorrectAnswer == "D" ? "bg-success" : "bg-secondary") me-2">D</span>
                                            <span class="@(q.CorrectAnswer == "D" ? "fw-bold text-success" : "text-dark")">@q.OptionD</span>
                                        </div>
                                        @if (q.CorrectAnswer == "D")
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle small">
                                                <i class="bi bi-check-circle-fill me-1"></i> Correct
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-question-circle display-4 text-muted d-block mb-3 opacity-50"></i>
                    <h6>No questions in this quiz yet</h6>
                    <p class="small text-muted mb-3">Add questions to enable learners to test their knowledge on this course.</p>
                    <a asp-controller="AdminQuizzes" asp-action="AddQuestion" asp-route-quizId="@Model.QuizId" class="btn btn-sm btn-primary rounded-pill px-4">
                        <i class="bi bi-plus-lg me-1"></i> Add First Question
                    </a>
                </div>
            }
        </div>
    </div>
</div>
