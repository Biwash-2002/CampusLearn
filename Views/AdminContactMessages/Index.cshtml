@model List<CampusLearn.Models.ContactMessage>
@{
    ViewData["Title"] = "Contact Inquiries Management";
}

<div class="py-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="Admin" asp-action="Dashboard" class="badge bg-warning text-dark text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Admin Console
                </a>
            </div>
            <h1 class="fw-bold text-dark mb-0">Public Contact Inquiries</h1>
        </div>
        <div class="mt-3 mt-md-0">
            <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fs-6">
                Total Inquiries: @Model.Count
            </span>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th>Sender Name</th>
                        <th>Email</th>
                        <th>Subject</th>
                        <th>Message</th>
                        <th>Submitted At</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold text-dark">@item.Name</td>
                                <td><a href="mailto:@item.Email" class="text-primary text-decoration-none">@item.Email</a></td>
                                <td class="fw-semibold">@item.Subject</td>
                                <td>
                                    <div class="text-muted small line-clamp-2" style="max-width: 320px;">
                                        @item.Message
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">@item.SubmittedAt.ToString("MMM dd, yyyy HH:mm")</span>
                                </td>
                                <td class="text-end">
                                    <form asp-controller="AdminContactMessages" asp-action="Delete" asp-route-id="@item.ContactMessageId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this message?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-light border text-danger" title="Delete Message">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-muted">
                                No contact inquiries received yet.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
