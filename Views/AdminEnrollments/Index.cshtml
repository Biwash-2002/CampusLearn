@model List<CampusLearn.Models.Enrollment>
@{
    ViewData["Title"] = "Enrollment Management";
    var courses = ViewBag.Courses as List<CampusLearn.Models.Course> ?? new List<CampusLearn.Models.Course>();
    var learners = ViewBag.Learners as List<CampusLearn.Models.ApplicationUser> ?? new List<CampusLearn.Models.ApplicationUser>();
    int? selectedCourseId = ViewBag.CourseId as int?;
    string? selectedUserId = ViewBag.UserId as string;
    var selectedCourse = ViewBag.SelectedCourse as CampusLearn.Models.Course;
    var selectedLearner = ViewBag.SelectedLearner as CampusLearn.Models.ApplicationUser;
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <a asp-controller="Admin" asp-action="Dashboard" class="badge bg-warning text-dark text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i> Admin Console
                </a>
            </div>
            <h1 class="fw-bold text-dark mb-0">Course Enrollment Management</h1>
            <p class="text-muted small mb-0">Manage student course enrollments, track progress percentages, and audit learning records.</p>
        </div>
        <div class="d-flex gap-2">
            <button type="button" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm" data-bs-toggle="modal" data-bs-target="#enrollModal">
                <i class="bi bi-plus-lg me-1"></i> Enroll Learner
            </button>
        </div>
    </div>

    <!-- Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 bg-white p-3 mb-4">
        <form asp-action="Index" method="get" class="row g-3 align-items-center">
            <div class="col-md-auto">
                <span class="fw-bold small text-muted"><i class="bi bi-funnel me-1"></i> Filters:</span>
            </div>
            <div class="col-md-4">
                <select name="courseId" class="form-select rounded-pill" onchange="this.form.submit()">
                    <option value="">-- All Courses (@courses.Count Total) --</option>
                    @foreach (var c in courses)
                    {
                        if (selectedCourseId.HasValue && selectedCourseId.Value == c.CourseId)
                        {
                            <option value="@c.CourseId" selected="selected">@c.Title</option>
                        }
                        else
                        {
                            <option value="@c.CourseId">@c.Title</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4">
                <select name="userId" class="form-select rounded-pill" onchange="this.form.submit()">
                    <option value="">-- All Learners (@learners.Count Total) --</option>
                    @foreach (var l in learners)
                    {
                        if (!string.IsNullOrEmpty(selectedUserId) && selectedUserId == l.Id)
                        {
                            <option value="@l.Id" selected="selected">@(l.FullName ?? l.UserName) (@l.Email)</option>
                        }
                        else
                        {
                            <option value="@l.Id">@(l.FullName ?? l.UserName) (@l.Email)</option>
                        }
                    }
                </select>
            </div>
            @if (selectedCourseId.HasValue || !string.IsNullOrEmpty(selectedUserId))
            {
                <div class="col-md-auto">
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">
                        <i class="bi bi-x-circle me-1"></i> Clear Filters
                    </a>
                </div>
            }
        </form>
    </div>

    <!-- Manual Enrollment Modal -->
    <div class="modal fade" id="enrollModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-person-plus text-primary me-2"></i> Enroll Student in Course
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-controller="AdminEnrollments" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Select Learner <span class="text-danger">*</span></label>
                            <select name="userId" asp-items="ViewBag.LearnersList" class="form-select bg-light" required>
                                <option value="">-- Choose Learner --</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold text-dark">Select Course <span class="text-danger">*</span></label>
                            <select name="courseId" asp-items="ViewBag.CoursesList" class="form-select bg-light" required>
                                <option value="">-- Choose Course --</option>
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer border-top p-3">
                        <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                            <i class="bi bi-check-lg me-1"></i> Enroll Learner
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Enrollments Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light small text-muted">
                    <tr>
                        <th style="width: 25%;">Learner</th>
                        <th style="width: 25%;">Course</th>
                        <th style="width: 15%;">Enrolled Date</th>
                        <th style="width: 15%;">Progress</th>
                        <th style="width: 10%;">Status</th>
                        <th style="width: 10%;" class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center me-2 flex-shrink-0" style="width: 36px; height: 36px; font-size: 0.9rem;">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <a asp-controller="AdminLearners" asp-action="Details" asp-route-id="@item.UserId" class="fw-bold text-dark text-decoration-none d-block">
                                                @(item.User?.FullName ?? item.User?.UserName ?? "User")
                                            </a>
                                            <span class="text-muted small">@item.User?.Email</span>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <a asp-controller="AdminCourses" asp-action="Details" asp-route-id="@item.CourseId" class="fw-semibold text-primary text-decoration-none">
                                        @item.Course.Title
                                    </a>
                                </td>
                                <td>
                                    <span class="text-muted small">@item.EnrollmentDate.ToString("MMM dd, yyyy")</span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2" style="max-width: 160px;">
                                        <div class="progress flex-grow-1" style="height: 6px;">
                                            <div class="progress-bar @(item.ProgressPercentage >= 100 ? "bg-success" : "bg-primary")" role="progressbar" style="width: @item.ProgressPercentage%"></div>
                                        </div>
                                        <span class="small fw-semibold text-dark">@item.ProgressPercentage%</span>
                                    </div>
                                </td>
                                <td>
                                    @if (item.Status == "Completed" || item.ProgressPercentage >= 100)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i> Completed
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-25 text-dark border border-warning-subtle px-2.5 py-1 rounded-pill">
                                            Active
                                        </span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-controller="AdminEnrollments" asp-action="Details" asp-route-id="@item.EnrollmentId" class="btn btn-light border" title="View Enrollment Details">
                                            <i class="bi bi-eye text-primary me-1"></i> Details
                                        </a>
                                        <a asp-controller="AdminEnrollments" asp-action="Delete" asp-route-id="@item.EnrollmentId" class="btn btn-light border text-danger" title="Remove Enrollment">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                <i class="bi bi-card-checklist display-4 text-muted d-block mb-3 opacity-50"></i>
                                <h5>No enrollment records found</h5>
                                <p class="small text-muted mb-3">
                                    @(selectedCourse != null ? $"No enrollments for '{selectedCourse.Title}'." : (selectedLearner != null ? $"No enrollments for '{selectedLearner.FullName ?? selectedLearner.Email}'." : "No learners enrolled in any courses yet."))
                                </p>
                                <button type="button" class="btn btn-sm btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#enrollModal">
                                    <i class="bi bi-plus-lg me-1"></i> Enroll a Student Now
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
